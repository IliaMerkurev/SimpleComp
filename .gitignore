# Unreal Engine 5 Plugin .gitignore

# Build Artifacts
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/           # UE sometimes creates extra build folders
# Keep only the two legacy skill entrypoints; unrelated local agent files stay ignored.
.agent/*
!.agent/skills/
.agent/skills/*
!.agent/skills/simplecomp-rules/
!.agent/skills/unreal-cpp-developer/
.agent/skills/simplecomp-rules/*
.agent/skills/unreal-cpp-developer/*
!.agent/skills/simplecomp-rules/SKILL.md
!.agent/skills/unreal-cpp-developer/SKILL.md

# IDE / Editor Files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.user
*.VC.db
*.VC.opendb

# Temporary / Log Files
*.tmp
*.log
*.iws
*.swp

# OS Generated
Thumbs.db
.DS_Store

# Ignore plugin-specific binary files
*.dll
*.lib
*.exp
*.pdb

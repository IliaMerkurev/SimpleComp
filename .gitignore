# Unreal Engine 5 Plugin .gitignore

# Build Artifacts
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/           # UE sometimes creates extra build folders
# Local coding skills are development tooling, not distributed plugin content.
.agents/
.agent/

# Local engineering instructions and implementation tracking
/AGENTS.md
/PROJECT.md
/STATUS.md
/MANUAL_ACCEPTANCE.md

# IDE / Editor Files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.user
*.VC.db
*.VC.opendb

# Temporary / Log Files
*.tmp
*.log
*.iws
*.swp

# OS Generated
Thumbs.db
.DS_Store

# Ignore plugin-specific binary files
*.dll
*.lib
*.exp
*.pdb
